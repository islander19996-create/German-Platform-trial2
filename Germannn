          <span>Сильные глаголы</span>
        </button>
        <button onclick="switchTab('grammar')" id="nav-grammar" class="w-full flex items-center space-x-4 px-4 py-3 rounded-xl font-extrabold text-sm uppercase tracking-wider text-gray-500 hover:bg-gray-100 border-2 border-transparent">
