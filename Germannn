<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>DeutschProfi — Полная интерактивная платформа немецкого языка (A1–B2)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    body {
      font-family: 'Nunito', sans-serif;
      background-color: #f7f7f7;
      user-select: none;
    }
    /* Тактильные 3D-кнопки в стиле Duolingo */
    .btn-duo-green {
      background-color: #58cc02;
      box-shadow: 0 4px 0 #58a700;
      color: white;
      transition: all 0.1s;
    }
    .btn-duo-green:hover { background-color: #61e002; }
    .btn-duo-green:active { transform: translateY(4px); box-shadow: 0 0px 0 #58a700; }

    .btn-duo-blue {
      background-color: #1cb0f6;
      box-shadow: 0 4px 0 #1899d6;
      color: white;
      transition: all 0.1s;
    }
    .btn-duo-blue:hover { background-color: #2bd5ff; }
    .btn-duo-blue:active { transform: translateY(4px); box-shadow: 0 0px 0 #1899d6; }

    .btn-duo-yellow {
      background-color: #ffc800;
      box-shadow: 0 4px 0 #e5a400;
      color: #4b4b4b;
      transition: all 0.1s;
    }
    .btn-duo-yellow:hover { background-color: #ffd426; }
    .btn-duo-yellow:active { transform: translateY(4px); box-shadow: 0 0px 0 #e5a400; }

    .btn-duo-purple {
      background-color: #ce82ff;
      box-shadow: 0 4px 0 #a559d9;
      color: white;
      transition: all 0.1s;
    }
    .btn-duo-purple:active { transform: translateY(4px); box-shadow: 0 0px 0 #a559d9; }

    .btn-duo-gray {
      background-color: #ffffff;
      border: 2px solid #e5e5e5;
      box-shadow: 0 4px 0 #e5e5e5;
      color: #4b4b4b;
      transition: all 0.1s;
    }
    .btn-duo-gray:hover { background-color: #f7f7f7; border-color: #cecece; }
    .btn-duo-gray:active { transform: translateY(4px); box-shadow: 0 0px 0 #e5e5e5; }

    .card-duo {
      background: white;
      border: 2px solid #e5e5e5;
      border-radius: 1.25rem;
      box-shadow: 0 4px 0 #e5e5e5;
    }

    /* 3D Переворот флеш-карт */
    .perspective { perspective: 1000px; }
    .flip-card-inner {
      position: relative;
      width: 100%;
      height: 100%;
      transition: transform 0.55s cubic-bezier(0.4, 0.2, 0.2, 1);
      transform-style: preserve-3d;
    }
    .flipped .flip-card-inner {
      transform: rotateY(180deg);
    }
    .flip-card-front, .flip-card-back {
      position: absolute;
      width: 100%;
      height: 100%;
      backface-visibility: hidden;
      border-radius: 1.5rem;
    }
    .flip-card-back {
      transform: rotateY(180deg);
    }
  </style>
</head>
<body class="text-gray-800 h-screen flex overflow-hidden">

  <!-- Боковая панель навигации -->
  <aside class="w-64 bg-white border-r-2 border-gray-200 flex flex-col justify-between z-20 shrink-0">
    <div>
      <!-- Логотип -->
      <div class="p-6 flex items-center space-x-3 border-b-2 border-gray-100">
        <div class="w-11 h-11 rounded-2xl bg-[#58cc02] flex items-center justify-center text-white font-black text-2xl shadow-[0_4px_0_#58a700]">
