          <i class="fa-solid fa-map-location-dot text-xl w-6 text-center"></i>
          <span>Карта уроков (12)</span>
        </button>
        <button onclick="switchTab('verbs')" id="nav-verbs" class="w-full flex items-center space-x-4 px-4 py-3 rounded-xl font-extrabold text-sm uppercase tracking-wider text-gray-500 hover:bg-gray-100 border-2 border-transparent">
